# App
APP_NAME=PensionQuest
APP_ENV=development
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./pensionquest.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=pq_session

# AI — all optional. With none set, the assistant answers from its built-in engine.
# Free options: Gemini (aistudio.google.com), Groq (console.groq.com), or local Ollama.
# Every configured provider is used as a fallback for the others.
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=
OPENAI_API_KEY=
AI_PROVIDER=gemini

# Prune AI gateway (optional, https://www.withprune.com). Save your Gemini/OpenAI key in the
# Prune dashboard (Connect > Providers), not here. With PRUNE_STRICT=true every AI request
# goes through Prune's screening; if Prune refuses or is down, the built-in engine answers.
PRUNE_API_KEY=
PRUNE_MODEL=gemini-2.5-flash
PRUNE_CACHE=exact
PRUNE_STRICT=true

# Google Translate
GOOGLE_TRANSLATE_API_KEY=...

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Encryption: generate a random key; keep it out of git and back it up separately.
DATA_ENCRYPTION_KEY=
NPS_ANNUITY_SHARE=0.20

# Real NSE day for the Coach and app (scripts/fetch_market_day.py). Empty = ../frontend/public/data/replay.json
MARKET_DATA_FILE=
