# Netlify / Cloudflare Pages. Hashed build assets never change, so cache them for a year;
# index.html must always be revalidated so new deploys are picked up. Both hosts serve
# Brotli/gzip automatically.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
